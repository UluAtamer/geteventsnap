# Values are supplied at runtime by Dokploy Environment; never add real secrets here.
DATABASE_URL=
DATABASE_POOL_MAX=10
SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to SITE_URL + /api/google/drive/callback
GOOGLE_REDIRECT_URI=
# Optional: grants admin access to this exact account UUID.
ADMIN_USER_ID=
GUEST_MAX_PHOTO_BYTES=26214400
GUEST_MAX_VIDEO_BYTES=524288000

# Optional first-deployment account. Disable and remove credentials after setup.
SEED_USER_ENABLED=false
SEED_USER_IS_ADMIN=false
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
