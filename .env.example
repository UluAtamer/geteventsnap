# Values are supplied at runtime by Dokploy Environment; never add real secrets here.
DATABASE_URL=
DATABASE_POOL_MAX=10
SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: defaults to SITE_URL + /api/google/drive/callback
GOOGLE_REDIRECT_URI=
DRIVE_TOKEN_ENCRYPTION_KEY=
# Optional: exact local account UUID; no administrator is enabled by default.
ADMIN_USER_ID=
GUEST_MAX_PHOTO_BYTES=26214400
GUEST_MAX_VIDEO_BYTES=524288000
